{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsc-node/tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.gif.config.ts",
    "playwright.og.config.ts",
    "csp.config.js",
    "scripts",
    "e2e",
    "gif",
    "og"
  ]
}
