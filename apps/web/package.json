{
  "name": "@lavra/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-csp.mjs && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "gif": "playwright test -c playwright.gif.config.ts && node scripts/video-para-gif.mjs",
    "cobertura:fontes": "node scripts/gerar-cobertura-fontes.mjs",
    "metricas:fontes": "node scripts/gerar-metricas-fontes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@lavra/pii-br": "workspace:*",
    "docx": "9.11.0",
    "pdfmake": "0.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "jsdom": "30.1.2",
    "unpdf": "1.8.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
